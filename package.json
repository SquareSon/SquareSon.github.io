{
  "name": "zi-fang-personal-homepage",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "worker:dev": "wrangler dev",
    "worker:build": "esbuild worker/index.ts --bundle --format=esm --platform=browser --target=es2023 --outfile=dist/worker.js",
    "worker:deploy": "wrangler deploy",
    "test": "npm run worker:build && npm run rag:eval && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate:site": "node scripts/validate-site.mjs",
    "rag:ingest": "node rag/scripts/ingest.mjs",
    "rag:seed": "node rag/scripts/build-d1-seed.mjs",
    "rag:eval": "node rag/scripts/evaluate-retrieval.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260804.1",
    "esbuild": "^0.25.9",
    "mammoth": "^1.12.0",
    "typescript": "5.9.3",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "type": "module"
}
