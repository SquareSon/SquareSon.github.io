# Public browser configuration. This value is not a secret.
# Leave empty to use the bundled static FAQ and site-search fallback only.
NEXT_PUBLIC_RAG_API_URL=

# Generation providers. Configure one or more; never expose these to the browser.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.5

# Routing, abuse protection, and budget controls.
AUTO_PROVIDER_ORDER=qwen,glm,deepseek,kimi
ALLOWED_ORIGINS=https://squareson.github.io
RATE_LIMIT_SALT=replace-with-a-long-random-secret
HOURLY_CLIENT_LIMIT=20
DAILY_REQUEST_LIMIT=250
TURNSTILE_SECRET_KEY=
