# Alibaba Cloud Model Studio uses one workspace API key for this public-model
# allowlist. Never expose a filled-in value to Jekyll or browser JavaScript.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash
DEEPSEEK_MODEL=deepseek-v4-flash
GLM_MODEL=glm-5.2
KIMI_MODEL=kimi/kimi-k3

# Optional OpenRouter model pool. Set MODEL_GATEWAY=openrouter to make these
# four reviewed model aliases the active public selection.
OPENROUTER_API_KEY=
MODEL_GATEWAY=bailian
OPENROUTER_QWEN_MODEL=qwen/qwen3.7-flash
OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_GLM_MODEL=z-ai/glm-5.2
OPENROUTER_KIMI_MODEL=moonshotai/kimi-k3

# Abuse protection and hashing secrets.
RATE_LIMIT_SALT=
TURNSTILE_SECRET_KEY=
