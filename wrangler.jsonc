{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zi-fang-research-assistant",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "zi-fang-public-rag-v1"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zi-fang-public-rag",
      "database_id": "7a591cec-2182-46b9-88a8-bb8e3bec91b5",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "MODEL_GATEWAY": "bailian",
    "AUTO_PROVIDER_ORDER": "bailian:deepseek,openrouter:deepseek,bailian:qwen",
    "ALLOWED_ORIGINS": "https://squareson.github.io,https://www.square-son.com,https://square-son.com,http://localhost:4000,http://127.0.0.1:4000",
    "LOCAL_RAG_URL": "https://rag.square-son.com",
    "LOCAL_RAG_TIMEOUT_MS": "12000",
    "HOURLY_CLIENT_LIMIT": "20",
    "DAILY_REQUEST_LIMIT": "250"
  },
  "observability": {
    "enabled": true
  }
}
